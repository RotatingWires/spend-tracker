[Unit]
Description=SpendTracker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace these paths and account before installation. Build first with:
#   dotnet publish -c Release -o /opt/spendtracker
User=spendtracker
WorkingDirectory=/opt/spendtracker
EnvironmentFile=-/etc/spendtracker.env
ExecStart=/usr/bin/dotnet /opt/spendtracker/SpendTracker.dll --urls http://127.0.0.1:8715 --data-dir /var/lib/spendtracker
Restart=on-failure
RestartSec=5
UMask=0077
# Encrypts the sign-in keys in data/keys with a secret only this service gets (src/SignInKeys.cs). Create it once:
#   head -c 32 /dev/urandom | sudo systemd-creds encrypt --name=spendtracker-sign-in-keys - /etc/credstore.encrypted/spendtracker-sign-in-keys
# Without it the service still starts; the keys are then owner-only files, unencrypted. Needs systemd 254 or later.
ImportCredential=spendtracker-sign-in-keys
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Create /opt/spendtracker/logs and make it writable by the service account.
ReadWritePaths=/var/lib/spendtracker /opt/spendtracker/logs

[Install]
WantedBy=multi-user.target
