<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SpendTracker</AssemblyName>
    <RootNamespace>SpendTracker</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.5.0</Version>
    <Product>SpendTracker</Product>
  </PropertyGroup>
  <ItemGroup>
    <!-- SQLite with SQLite3 Multiple Ciphers, which encrypts spendtracker.db when a database key exists (src/DatabaseKey.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <Target Name="GenerateWebVersion" BeforeTargets="Build">
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/wwwroot/version.json"
      Lines="{&quot;version&quot;:&quot;$(Version)&quot;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
